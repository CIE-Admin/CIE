<Window x:Class="CIE.CategoryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="分类管理" Width="760" Height="560" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="#F3F5F8">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F0F1F5"/>
            <Setter Property="Foreground" Value="#343945"/>
            <Setter Property="BorderBrush" Value="#DEE1E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E8D9F3"/><Setter Property="Foreground" Value="#57306D"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D9C2E9"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="版本分类管理" FontSize="24" FontWeight="Bold" Foreground="#20242A"/>
            <TextBlock x:Name="SelectedVersionText" Text="管理已安装版本的文件夹分类。" Margin="0,6,0,0" Foreground="#667080"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="分类文件夹" FontWeight="SemiBold" Margin="4,3,4,10"/>
                    <ListBox x:Name="FolderListBox" SelectionChanged="FolderListBox_SelectionChanged" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,5">
                                    <Border Width="30" Height="30" Background="#EEF1F5" CornerRadius="5" Margin="0,0,10,0">
                                        <Image Source="{Binding Icon}" Width="26" Height="26" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="创建或重命名" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="选中左侧分类后，可修改名称或删除分类。" Margin="0,5,0,10" Foreground="#667080" TextWrapping="Wrap"/>
                        <TextBox x:Name="FolderNameTextBox" Height="34" Padding="8" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <Button Content="新建分类" Padding="12,7" Margin="0,0,8,8" Click="CreateFolder_Click"/>
                            <Button Content="重命名" Padding="12,7" Margin="0,0,8,8" Click="RenameFolder_Click"/>
                            <Button Content="删除分类" Padding="12,7" Margin="0,0,8,8" Click="DeleteFolder_Click"/>
                        </WrapPanel>
                        <Separator Margin="0,8,0,14"/>
                        <TextBlock Text="文件夹图标" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="推荐使用正方形 PNG、JPG 或 BMP 图片。图片最长边不超过 4096 像素、文件不超过 20 MB；导入后会自动缩放并压缩为 96×96 PNG 图标。"
                                   Margin="0,5,0,10" Foreground="#667080" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="58" Height="58" CornerRadius="8" Background="#EEF1F5" Padding="4" Margin="0,0,12,0">
                                <Image x:Name="IconPreview" Stretch="Uniform"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <Button Content="选择图片…" Padding="12,7" Margin="0,0,0,6" Click="ChooseIcon_Click"/>
                                <Button Content="恢复默认文件夹图标" Padding="12,7" Click="ResetIcon_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <Separator Margin="0,4,0,14"/>
                        <TextBlock Text="版本归类" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AssignHintText" Text="可在已安装版本列表中按 Ctrl 或 Shift 多选，再统一归入一个文件夹。" Margin="0,5,0,9" Foreground="#667080" TextWrapping="Wrap"/>
                        <ComboBox x:Name="AssignFolderComboBox" Height="34" SelectionChanged="AssignFolderComboBox_SelectionChanged"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="完成" IsDefault="True" Padding="18,8" Click="Done_Click"/>
        </StackPanel>
    </Grid>
</Window>