<Window x:Class="CIE.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CIE 更新日志"
        Width="760"
        Height="620"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F4F4"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F1F1F1"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#111111"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111111"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#444444"/>
        <SolidColorBrush x:Key="MutedDimBrush" Color="#666666"/>
        <SolidColorBrush x:Key="OnAccentTextBrush" Color="#FFFFFF"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.68"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource CardBrush}" CornerRadius="18" Padding="24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock x:Name="HeadingText" Text="历史更新日志" FontSize="25" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock x:Name="SubheadingText" Text="CIE Launcher" Margin="0,6,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <Border Height="1" Background="{DynamicResource BorderBrushColor}" Margin="0,16,0,0"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ReleaseItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushColor}"
                                        BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding PublishedLabel}" DockPanel.Dock="Right"
                                                       Foreground="{DynamicResource MutedDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Version}" FontSize="17" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Notes}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Button x:Name="CloseButton" Grid.Row="1" Content="关闭" HorizontalAlignment="Right" Margin="0,14,0,0"
                Click="CloseButton_Click"/>
    </Grid>
</Window>